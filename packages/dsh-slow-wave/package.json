{
  "name": "dsh-slow-wave",
  "version": "0.3.0",
  "type": "module",
  "description": "What it does while she sleeps: tidy the element memory with a local model (model-approved synonym merges, trimmed descriptions, pruned weak edges, analogies to confirm), then dream — stitch her own past experiences into a short story and leave one labelled line on her desk. Backup before every write; the dream never enters her memory.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "consolidation",
    "ollama",
    "idle",
    "agent-memory",
    "dream",
    "dsh-fish"
  ],
  "license": "MIT",
  "author": "Xiaocanglan-hub",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xiaocanglan-hub/dsh-whale-memory.git",
    "directory": "packages/dsh-slow-wave"
  },
  "homepage": "https://github.com/Xiaocanglan-hub/dsh-whale-memory/tree/main/packages/dsh-slow-wave",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "dream/*.js",
    "dream/*.mjs",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "peerDependencies": {
    "dsh-memory-brain": "*",
    "@ssamurias/dsh-fish": "*"
  },
  "peerDependenciesMeta": {
    "dsh-memory-brain": {
      "optional": true
    },
    "@ssamurias/dsh-fish": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "bugs": {
    "url": "https://github.com/Xiaocanglan-hub/dsh-whale-memory/issues"
  }
}
